# Application
NODE_ENV=development
PORT=4000
WEB_PORT=3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME="Aurelia Motors"
NEXT_PUBLIC_APP_TAGLINE="A considered collection of vehicles for those who see driving as something more."

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aurelia_motors?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aurelia_motors
POSTGRES_PORT=5432

# Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_987654321
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_change_in_production_123456789
JWT_REFRESH_EXPIRATION=7d

# File Storage (Local Disk Storage)
UPLOAD_DESTINATION=./uploads
UPLOAD_MAX_SIZE_MB=10
PUBLIC_STORAGE_URL=http://localhost:4000/uploads

# Email Notifications (Nodemailer / SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_smtp_user
SMTP_PASSWORD=mock_smtp_pass
EMAIL_FROM="Aurelia Motors Concierge <concierge@aureliamotors.com>"
ADMIN_EMAIL="admin@aureliamotors.com"

# Admin Seed
DEFAULT_ADMIN_EMAIL=admin@carshowroom.local
DEFAULT_ADMIN_PASSWORD=Admin@12345
